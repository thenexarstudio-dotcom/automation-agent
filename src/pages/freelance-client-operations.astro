---
import { getEntry, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CTA from "@/components/CTA.astro";
import GumroadButton from "@/components/GumroadButton.astro";

const entry = await getEntry("pillar", "freelance-client-operations");
const { Content } = await render(entry!);
---
<BaseLayout title={entry!.data.seoTitle} description={entry!.data.seoDescription}>
  <div class="mx-auto max-w-3xl px-5 py-14">
    <header class="mb-8">
      <h1 class="text-4xl leading-tight">{entry!.data.title}</h1>
      <p class="mt-3 text-lg text-ink-500 max-w-prose">{entry!.data.dek}</p>
    </header>
    <article class="prose-doc">
      <Content />
    </article>
    <CTA
      eyebrow="Start here"
      title="Get all 12 documents in one purchase"
      body="The Consultant Client Ops Kit covers the entire client lifecycle above in one bundle."
    >
      <GumroadButton product="kit" />
    </CTA>
  </div>
</BaseLayout>
