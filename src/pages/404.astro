---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="Page Not Found | Consultant Client Ops" description="The page you're looking for doesn't exist.">
  <div class="mx-auto max-w-2xl px-5 py-24 text-center">
    <p class="text-brass-700 text-sm font-medium uppercase tracking-wide">404</p>
    <h1 class="text-4xl leading-tight mt-3">This page took some scope creep and wandered off.</h1>
    <p class="mt-4 text-lg text-ink-500">
      The link's broken or the page moved. Here's where most people are headed:
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a href="/templates" class="no-underline rounded-lg bg-ink-950 px-5 py-2.5 text-sm font-medium text-white hover:bg-ink-900">Browse the templates</a>
      <a href="/tools" class="no-underline text-ink-700 font-medium hover:text-brass-700">Try the free tools &rarr;</a>
      <a href="/blog" class="no-underline text-ink-700 font-medium hover:text-brass-700">Read the blog &rarr;</a>
    </div>
  </div>
</BaseLayout>
