---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const tools = await getCollection("tools");
---
<BaseLayout
  title="Free Tools & Calculators for Freelancers | Consultant Client Ops"
  description="Free, no-signup calculators for freelancers: day rate, scope-creep cost, retainer profitability, and a scope-of-work generator. Everything runs in your browser."
>
  <div class="mx-auto max-w-5xl px-5 py-14">
    <header class="mb-10">
      <p class="text-brass-700 text-sm font-medium uppercase tracking-wide">Free · no signup</p>
      <h1 class="text-4xl leading-tight mt-1">The tools</h1>
      <p class="mt-3 text-lg text-ink-500 max-w-prose">
        Quick calculators and generators for the numbers that decide whether a freelance project is actually worth it. Nothing you enter leaves your browser.
      </p>
    </header>
    <div class="grid sm:grid-cols-2 gap-4">
      {tools.map((t) => (
        <a href={`/tools/${t.slug}`} class="no-underline card p-6 hover:border-brass-400 transition-colors">
          <p class="font-medium text-ink-950 text-lg">{t.data.title}</p>
          <p class="mt-2 text-sm text-ink-500">{t.data.dek}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
