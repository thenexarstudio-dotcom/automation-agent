---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CTA from "@/components/CTA.astro";
import GumroadButton from "@/components/GumroadButton.astro";

interface Props {
  seoTitle: string;
  seoDescription: string;
  title: string;
  dek: string;
  publishDate: string;
  relatedTemplates?: { href: string; label: string }[];
  relatedTool?: { href: string; label: string };
}
const { seoTitle, seoDescription, title, dek, publishDate, relatedTemplates = [], relatedTool } = Astro.props;
---
<BaseLayout title={seoTitle} description={seoDescription}>
  <div class="mx-auto max-w-3xl px-5 py-14">
    <header class="mb-8">
      <p class="text-ink-500 text-sm">{new Date(publishDate).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</p>
      <h1 class="text-4xl leading-tight mt-1">{title}</h1>
      <p class="mt-3 text-lg text-ink-500 max-w-prose">{dek}</p>
    </header>

    <article class="prose-doc">
      <slot />
    </article>

    {(relatedTemplates.length > 0 || relatedTool) && (
      <section class="mt-12 card p-6">
        <h2 class="text-lg font-serif text-ink-950 mb-3">Keep going</h2>
        <ul class="space-y-2 text-sm">
          {relatedTool && <li><a href={relatedTool.href}>{relatedTool.label}</a> <span class="text-ink-500">— free tool</span></li>}
          {relatedTemplates.map((t) => (
            <li><a href={t.href}>{t.label}</a></li>
          ))}
        </ul>
      </section>
    )}

    <CTA
      eyebrow="Stop rebuilding this from scratch"
      title="Get the done-for-you version."
      body="The Consultant Client Ops Kit turns what you just read into 12 ready-to-send documents."
    >
      <GumroadButton product="kit" />
    </CTA>
  </div>
</BaseLayout>
