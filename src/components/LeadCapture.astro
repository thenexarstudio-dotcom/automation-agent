---
// Email capture via Netlify Forms — works with zero backend and no ESP:
// Netlify detects the static form at build (data-netlify), stores every
// submission in the site dashboard, and redirects to `action` on success.
// Connect an ESP later for automated nurture; until then the cheatsheet is
// delivered immediately on /thank-you and addresses collect in Netlify.
interface Props {
  source?: string;
  heading?: string;
  blurb?: string;
  cta?: string;
  class?: string;
}
const {
  source = "site",
  heading = "Get the free Freelance Pricing & Proposal Cheatsheet",
  blurb = "The day-rate formula, the 7-section proposal, scope-creep and payment fixes — one page each. No spam, unsubscribe anytime.",
  cta = "Email me the cheatsheet",
  class: className = "",
} = Astro.props;
---
<div class={`card p-6 md:p-8 bg-ink-950 text-ink-50 border-none ${className}`}>
  <h2 class="text-2xl font-serif text-white">{heading}</h2>
  <p class="mt-2 text-ink-100 max-w-prose">{blurb}</p>
  <form
    name="lead-magnet"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    action="/thank-you"
    class="mt-5 flex flex-col sm:flex-row gap-3 max-w-xl"
  >
    <input type="hidden" name="form-name" value="lead-magnet" />
    <input type="hidden" name="source" value={source} />
    <p class="hidden">
      <label>Leave this empty: <input name="bot-field" /></label>
    </p>
    <label class="sr-only" for={`email-${source}`}>Email address</label>
    <input
      id={`email-${source}`}
      type="email"
      name="email"
      required
      placeholder="you@work.com"
      class="flex-1 rounded-lg border border-ink-700 bg-ink-900 px-4 py-3 text-white placeholder:text-ink-500 outline-none focus:border-brass-400"
    />
    <button
      type="submit"
      class="rounded-lg bg-brass-600 px-6 py-3 font-medium text-white hover:bg-brass-700 transition-colors whitespace-nowrap"
    >
      {cta}
    </button>
  </form>
  <p class="mt-3 text-xs text-ink-300">Instant download on the next page — the email just lets us send occasional new templates.</p>
</div>
