---
interface Props {
  eyebrow?: string;
  title: string;
  body: string;
}
const { eyebrow, title, body } = Astro.props;
---
<section class="card mt-14 p-8 bg-ink-950 text-ink-50 border-none">
  {eyebrow && <p class="text-brass-400 text-sm font-medium uppercase tracking-wide">{eyebrow}</p>}
  <h2 class="text-2xl font-serif mt-2 text-white">{title}</h2>
  <p class="mt-2 text-ink-100 max-w-prose">{body}</p>
  <div class="mt-5">
    <slot />
  </div>
</section>
