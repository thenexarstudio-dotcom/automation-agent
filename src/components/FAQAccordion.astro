---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="mt-12" aria-label="Frequently asked questions">
    <h2 class="text-2xl font-serif text-ink-950 mb-4">FAQ</h2>
    <div class="divide-y divide-ink-100 card px-5">
      {items.map((item) => (
        <details class="group py-4">
          <summary class="cursor-pointer list-none flex items-center justify-between font-medium text-ink-950">
            {item.q}
            <span class="ml-4 text-ink-300 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-2 text-ink-700 leading-relaxed">{item.a}</p>
        </details>
      ))}
    </div>
  </section>
)}

<script is:inline type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
})} />
