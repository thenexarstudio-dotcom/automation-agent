---
const links = [
  { href: "/templates", label: "Templates" },
  { href: "/tools", label: "Tools" },
  { href: "/blog", label: "Blog" },
  { href: "/guides/feast-or-famine-fix", label: "The Ebook" },
  { href: "/freelance-client-operations", label: "Start Here" },
];
---
<header class="border-b border-ink-100 bg-ink-50/90 backdrop-blur sticky top-0 z-40">
  <div class="mx-auto max-w-6xl px-5 h-16 flex items-center justify-between">
    <a href="/" class="no-underline font-serif text-lg font-semibold text-ink-950 tracking-tight">
      Consultant Client Ops
    </a>
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-ink-700">
      {links.map((l) => (
        <a href={l.href} class="no-underline hover:text-brass-700">{l.label}</a>
      ))}
    </nav>
    <a
      href="/templates/consulting-proposal-template"
      class="no-underline rounded-lg bg-ink-950 px-4 py-2 text-sm font-medium text-white hover:bg-ink-900"
    >
      Get the Kit
    </a>
  </div>
</header>
