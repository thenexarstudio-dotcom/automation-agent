---
const templateLinks = [
  { href: "/templates/consulting-proposal-template", label: "Proposal Template" },
  { href: "/templates/scope-of-work-template", label: "Scope of Work Template" },
  { href: "/templates/freelance-contract-template", label: "Contract Template" },
];
const toolLinks = [
  { href: "/tools/freelance-day-rate-calculator", label: "Day Rate Calculator" },
  { href: "/tools/scope-creep-cost-calculator", label: "Scope Creep Calculator" },
  { href: "/tools/sow-generator", label: "SOW Generator" },
];
---
<footer class="border-t border-ink-100 mt-24 bg-white">
  <div class="mx-auto max-w-6xl px-5 py-12 grid grid-cols-2 md:grid-cols-4 gap-8 text-sm">
    <div class="col-span-2 md:col-span-1">
      <p class="font-serif text-lg text-ink-950">Consultant Client Ops</p>
      <p class="mt-2 text-ink-500">Templates and tools for freelancers and consultants who'd rather run client work than reinvent it.</p>
    </div>
    <div>
      <p class="font-medium text-ink-950 mb-3">Templates</p>
      <ul class="space-y-2">
        {templateLinks.map((l) => <li><a href={l.href} class="no-underline text-ink-500 hover:text-brass-700">{l.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="font-medium text-ink-950 mb-3">Free tools</p>
      <ul class="space-y-2">
        {toolLinks.map((l) => <li><a href={l.href} class="no-underline text-ink-500 hover:text-brass-700">{l.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="font-medium text-ink-950 mb-3">Company</p>
      <ul class="space-y-2">
        <li><a href="/guides/feast-or-famine-fix" class="no-underline text-ink-500 hover:text-brass-700">The Ebook</a></li>
        <li><a href="/terms" class="no-underline text-ink-500 hover:text-brass-700">Terms</a></li>
        <li><a href="/privacy" class="no-underline text-ink-500 hover:text-brass-700">Privacy</a></li>
        <li><a href="/refund-policy" class="no-underline text-ink-500 hover:text-brass-700">Refund Policy</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-ink-100 py-6 text-center text-xs text-ink-300">
    &copy; {new Date().getFullYear()} Consultant Client Ops. All templates are starting-point drafts, not legal advice.
  </div>
</footer>
