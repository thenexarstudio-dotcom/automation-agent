# Copy to .env and fill in once you have accounts for these — the site
# builds and runs fine with these unset (chat widget and analytics simply
# don't render).

# Hosted AI chat widget (e.g. Chatbase) — chatbot ID after uploading the
# src/content/faq/**/*.md corpus as its training data.
PUBLIC_CHATBOT_ID=

# Plausible Analytics — your live domain, e.g. consultant-client-ops.netlify.app
PUBLIC_PLAUSIBLE_DOMAIN=
